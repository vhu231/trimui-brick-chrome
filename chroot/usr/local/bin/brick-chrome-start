#!/bin/sh
# Runs inside the /opt/brick-chrome chroot with DISPLAY already set.
# launch.sh passes BRICK_SCALE / BRICK_WIN_W / BRICK_WIN_H; the fallbacks keep
# this usable when started by hand.
export LANG=C.UTF-8

SCALE=${BRICK_SCALE:-1.5}
WIN_W=${BRICK_WIN_W:-683}
WIN_H=${BRICK_WIN_H:-512}

# Chrome 136+ ignores --remote-debugging-port when the profile lives at the
# default path, so the voice key needs the profile somewhere else.  Rename it
# once rather than starting fresh, which would drop history, logins and the
# microphone permissions already granted.
# brick-x11.sh may already have made $PROFILE a mount point on UDISK, so test
# for actual profile contents rather than for the directory, and copy rather
# than rename -- a rename onto a mount point fails.
PROFILE=/home/brick/.config/brick-profile
DEFAULT=/home/brick/.config/google-chrome
mkdir -p "$PROFILE"
if [ -d "$DEFAULT" ] && [ ! -d "$PROFILE/Default" ]; then
    cp -a "$DEFAULT"/. "$PROFILE"/ && rm -rf "$DEFAULT" \
        && echo "migrated Chrome profile to $PROFILE"
fi
chown brick:brick "$PROFILE" 2>/dev/null || true

# --window-size is in logical pixels, so it has to be divided by the scale
# factor for the window to come out at the panel's 1024x768.
# Memory, not disk, is the binding constraint here: 975 MB of RAM against a
# desktop Chrome.  Without these the browser swapped hard enough that kswapd sat
# at 23% CPU with 29% iowait, and a second renderer could not even start -- V8
# reported "Failed to reserve virtual memory for CodeRange" when mmap hit ENOMEM.
#
# Site isolation stays on deliberately.  Turning it off would save the most
# memory, because it is what gives every distinct site its own process, but it
# is also the boundary that keeps one site's data out of another site's process
# -- the defence against Spectre-style cross-site reads.  The savings below come
# from caches and process count instead.
#
# brick-x11.sh puts a tmpfs behind /dev/shm.  Fall back to /tmp only when it is
# missing: Chrome backs its shared memory with files, and /tmp is on the eMMC.
SHM=
grep -q ' /tmp/shm tmpfs ' /proc/mounts || SHM=--disable-dev-shm-usage

# GPU (BRICK_GPU=1, from gpu.txt): Skia rasterises and composites through the
# stock PowerVR Vulkan driver, and WebGL runs on ANGLE sharing the same device
# (VulkanFromANGLE).  The driver cannot present to X11; VK_LAYER_BRICK_x11_wsi
# supplies the swapchain, and the brickext Xorg module is what lets Chrome ask
# for one.  Measured against --disable-gpu on the device: scrolling the same
# 60 fps, CSS animation 26 fps instead of 5.6, canvas 41 instead of 27, and
# WebGL only exists here -- for roughly 30-60 MB more memory.
if [ "${BRICK_GPU:-1}" = 1 ]; then
    GPU="--enable-features=Vulkan,VulkanFromANGLE
--use-vulkan=native
--use-angle=vulkan
--ignore-gpu-blocklist
--enable-gpu-rasterization"
    VKENV="BRICK_VK_X11_WSI=1 ${BRICK_WSI_DEBUG:+BRICK_WSI_DEBUG=$BRICK_WSI_DEBUG}"
else
    GPU=--disable-gpu
    VKENV=
fi

ARGS="--ozone-platform=x11
$GPU
$SHM
--password-store=basic
--no-first-run
--no-default-browser-check
--enable-low-end-device-mode
--renderer-process-limit=2
--process-per-site
--disk-cache-size=67108864
--disable-features=Translate,MediaRouter,BackForwardCache
--lang=zh-CN
--accept-lang=zh-CN,zh,en
--alsa-input-device=hw:0,0
--alsa-output-device=plughw:0,0
--user-data-dir=$PROFILE
--remote-debugging-port=9222
--force-device-scale-factor=$SCALE
--window-position=0,0
--window-size=$WIN_W,$WIN_H"

# White-with-black-outline pointer, scaled up: the panel is 3.2 inches at about
# 400 PPI, so the stock 24px cursor is roughly 1.5 mm and the default dark one
# disappears over dark pages.  su does not carry these through, so they go
# inside the command it runs.
CURSOR="XCURSOR_THEME=DMZ-White XCURSOR_SIZE=${BRICK_CURSOR_SIZE:-48}"

exec /usr/bin/su -s /bin/sh brick -c \
    "exec env $CURSOR $VKENV /usr/bin/google-chrome-stable $(echo $ARGS) \"\$@\"" _ "$@"
